# Copy to .env and set credentials in your deployment environment.
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_MODEL=gpt-6-astra
OPENAI_FALLBACK_MODEL=gpt-6-astra
MAX_CONCURRENT_RUNS=1

# Optional: select Anthropic instead with LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# REASONING_MODEL=claude-opus-4-8
